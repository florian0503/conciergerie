{% extends 'base.html.twig' %}

{% block title %}Contact — Les Clés Lyonnaises · Conciergerie à Lyon{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/contact.css') }}">
{% endblock %}

{% block body %}

<!-- ═══════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════ -->
<section class="contact-hero">
    <div class="contact-hero-inner">

        <nav class="contact-breadcrumb" aria-label="Fil d'ariane">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span class="contact-breadcrumb-sep">›</span>
            <span class="contact-breadcrumb-current">Contact</span>
        </nav>

        <span class="contact-hero-eyebrow">Parlons-nous</span>

        <h1 class="contact-hero-title reveal">
            Discutons de<br>
            <em>votre bien.</em>
        </h1>

        <p class="contact-hero-sub reveal" data-delay="2">
            Remplissez le formulaire ci-dessous et recevez une réponse personnalisée sous 24 h. Nous sommes là pour répondre à toutes vos questions.
        </p>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     BODY
════════════════════════════════════════════════════════════ -->
<section class="contact-body">
    <div class="contact-body-inner">

        <!-- ── Formulaire ─────────────────────────────────── -->
        <div class="contact-form-col reveal">

            <div class="contact-form-card">

            <div class="contact-form-head">
                <span class="contact-form-label-top">Formulaire de contact</span>
                <h2 class="contact-form-title">Envoyez-nous<br>votre demande</h2>
            </div>

            <form class="contact-form" novalidate>

                <div class="contact-field contact-field-row">
                    <div>
                        <label class="contact-field-label" for="contact-nom">Nom *</label>
                        <input type="text" id="contact-nom" name="nom" placeholder="Votre nom" required>
                    </div>
                    <div>
                        <label class="contact-field-label" for="contact-prenom">Prénom *</label>
                        <input type="text" id="contact-prenom" name="prenom" placeholder="Votre prénom" required>
                    </div>
                </div>

                <div class="contact-field">
                    <label class="contact-field-label" for="contact-email">Email *</label>
                    <input type="email" id="contact-email" name="email" placeholder="votre@email.com" required>
                </div>

                <div class="contact-field">
                    <label class="contact-field-label" for="contact-tel">Téléphone</label>
                    <input type="tel" id="contact-tel" name="telephone" placeholder="+33 6 00 00 00 00">
                </div>

                <div class="contact-field">
                    <label class="contact-field-label" for="contact-message">Message *</label>
                    <textarea id="contact-message" name="message" placeholder="Décrivez votre bien et vos attentes en quelques mots…" required></textarea>
                </div>

                <div class="contact-consent">
                    <input type="checkbox" id="contact-rgpd" name="rgpd" required>
                    <label class="contact-consent-text" for="contact-rgpd">
                        J'accepte la <a href="{{ path('app_confidentialite') }}">politique de confidentialité</a> et consens au traitement de mes données personnelles dans le cadre de ma demande.
                    </label>
                </div>

                <div class="contact-submit-wrap">
                    <button type="submit" class="contact-submit">
                        Envoyer ma demande
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="8" x2="13" y2="8"/>
                            <polyline points="9 4 13 8 9 12"/>
                        </svg>
                    </button>
                    <p class="contact-submit-note">* Champs obligatoires</p>
                </div>

            </form>

            </div>{# /.contact-form-card #}
        </div>

        <!-- ── Infos + Garanties ──────────────────────────── -->
        <aside class="contact-info">

            <!-- Coordonnées -->
            <div class="contact-info-card reveal" data-delay="2">
                <h3 class="contact-info-card-title">Informations de contact</h3>
                <p class="contact-info-card-sub">Vous préférez nous contacter directement ? Nous sommes disponibles du lundi au samedi.</p>

                <ul class="contact-info-list">
                    <li class="contact-info-item">
                        <span class="contact-info-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <div class="contact-info-text">
                            <span class="contact-info-key">Email</span>
                            <span class="contact-info-val"></span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <span class="contact-info-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.21 3.25 2 2 0 0 1 3.22 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l.92.92z"/>
                            </svg>
                        </span>
                        <div class="contact-info-text">
                            <span class="contact-info-key">Téléphone</span>
                            <span class="contact-info-val"><a href="tel:+33769314803">+33 7 69 31 48 03</a></span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <span class="contact-info-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                        </span>
                        <div class="contact-info-text">
                            <span class="contact-info-key">Disponibilité</span>
                            <span class="contact-info-val">Lun — Sam · 9h — 19h</span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <span class="contact-info-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                        </span>
                        <div class="contact-info-text">
                            <span class="contact-info-key">Adresse</span>
                            <span class="contact-info-val">9 Avenue Benoît Launay, 69290 Grézieu-la-Varenne</span>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Réseaux sociaux -->
            <div class="contact-social-card reveal" data-delay="3">
                <p class="contact-social-title">Suivez-nous</p>
                <div class="contact-social-links">
                    <a href="#" class="contact-social-btn" aria-label="Instagram">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5"/>
                            <circle cx="12" cy="12" r="4"/>
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                        </svg>
                    </a>
                    <a href="#" class="contact-social-btn" aria-label="LinkedIn">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                            <rect x="2" y="9" width="4" height="12"/>
                            <circle cx="4" cy="4" r="2"/>
                        </svg>
                    </a>
                </div>
            </div>

        </aside>

    </div>
</section>

{% endblock %}
