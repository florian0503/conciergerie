{% extends 'base.html.twig' %}

{% block title %}Logements — Les Clés Lyonnaises{% endblock %}
{% block meta_description %}Nos logements en location courte durée à Lyon. Découvrez une sélection de biens gérés par Les Clés Lyonnaises.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/logements.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO ════════════════════════════════════════════════ -->
<section class="lg-hero">
    <div class="lg-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">Logements</span>
        </nav>
        <h1 class="lg-title">
            Une sélection<br>
            de <em>belles adresses</em><br>
            à Lyon.
        </h1>
        <p class="lg-subtitle">Chaque bien est choisi pour son caractère, sa localisation, et l'envie que nous avons d'y passer nous-mêmes un week-end.</p>
    </div>
</section>

<!-- ══ FILTRES + GRILLE ═══════════════════════════════════ -->
<section class="lg-catalog">
    <div class="lg-wrap">

        <div class="lg-filters-bar">
            <div class="lg-filters">
                <button class="lg-filter is-active" data-filter="tous">Tous</button>
                {% for quartier in quartiers %}
                    <button class="lg-filter" data-filter="{{ quartier.slug }}">{{ quartier.nom }}</button>
                {% endfor %}
            </div>
            <span class="lg-count"><span id="lg-count-num">{{ logements|length }}</span> biens</span>
        </div>

        <div class="lg-grid" id="lg-grid">

            {% for logement in logements %}
            <a href="{{ path('app_logement_show', {slug: logement.slug}) }}" class="lg-card reveal ld-card-link" data-delay="{{ loop.index }}" data-quartier="{{ logement.quartierSlug }}">
                <div class="lg-img lg-img--{{ logement.imgIndex }}"{% if logement.photos is not empty %} data-bg="{{ logement.photos[0] }}"{% endif %}>
                    <span class="lg-badge">{{ logement.type }}</span>
                    <span class="lg-rating">★ {{ logement.note }}</span>
                </div>
                <div class="lg-info">
                    <h2 class="lg-name">{{ logement.nom }}</h2>
                    <p class="lg-meta">{{ logement.quartier }} · {{ logement.voyageurs }} voyageurs · {{ logement.chambres }} ch.</p>
                </div>
            </a>
            {% endfor %}

        </div>

        <p class="lg-empty" id="lg-empty">Aucun bien disponible dans cette zone pour le moment.</p>

    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.querySelectorAll('[data-bg]').forEach(function (el) {
        el.style.backgroundImage = 'url(' + el.dataset.bg + ')';
    });
    document.addEventListener('DOMContentLoaded', function () {
        var filters  = document.querySelectorAll('.lg-filter');
        var cards    = document.querySelectorAll('.lg-card');
        var countEl  = document.getElementById('lg-count-num');
        var emptyEl  = document.getElementById('lg-empty');

        filters.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var val = btn.getAttribute('data-filter');

                filters.forEach(function (b) { b.classList.remove('is-active'); });
                btn.classList.add('is-active');

                var visible = 0;
                cards.forEach(function (card) {
                    var match = val === 'tous' || card.getAttribute('data-quartier') === val;
                    card.style.display = match ? '' : 'none';
                    if (match) visible++;
                });

                countEl.textContent = visible;
                emptyEl.classList.toggle('is-visible', visible === 0);
            });
        });
    });
    </script>
{% endblock %}
