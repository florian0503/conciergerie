{% extends 'base.html.twig' %}

{% block title %}{{ logement.nom }} — Maison Mathis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/logements.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/logement-detail.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO PHOTO ═══════════════════════════════════════════ -->
<section class="ld-hero">
    <div class="ld-hero-img ld-hero-img--{{ logement.img_index }}">
        <div class="ld-hero-overlay"></div>
        <div class="ld-hero-content lg-wrap">
            <nav class="breadcrumb" aria-label="Fil d'ariane">
                <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
                <span class="breadcrumb-sep">／</span>
                <a class="breadcrumb-link" href="{{ path('app_logements') }}">Logements</a>
                <span class="breadcrumb-sep">／</span>
                <span class="breadcrumb-current">{{ logement.nom }}</span>
            </nav>
            <div class="ld-hero-meta">
                <span class="ld-badge">{{ logement.type }}</span>
                <span class="ld-rating">★ {{ logement.note }} · {{ logement.avis }} avis</span>
            </div>
            <h1 class="ld-title">{{ logement.nom }}</h1>
            <p class="ld-location">{{ logement.quartier }}</p>
        </div>
    </div>
</section>

<!-- ══ CONTENU PRINCIPAL ════════════════════════════════════ -->
<div class="ld-layout lg-wrap">

    <!-- COLONNE GAUCHE -->
    <div class="ld-main">

        <!-- Infos capacité -->
        <div class="ld-specs">
            <div class="ld-spec">
                <span class="ld-spec-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <span>{{ logement.voyageurs }} voyageurs</span>
            </div>
            <div class="ld-spec">
                <span class="ld-spec-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </span>
                <span>{{ logement.chambres }} chambre{{ logement.chambres > 1 ? 's' : '' }}</span>
            </div>
            <div class="ld-spec">
                <span class="ld-spec-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <span>Disponible à la réservation</span>
            </div>
        </div>

        <hr class="ld-divider">

        <!-- Description -->
        <div class="ld-section">
            <h2 class="ld-section-title">À propos de ce logement</h2>
            <p class="ld-description">{{ logement.description }}</p>
        </div>

        <hr class="ld-divider">

        <!-- Équipements -->
        <div class="ld-section">
            <h2 class="ld-section-title">Ce que propose ce logement</h2>
            <ul class="ld-equipements">
                {% for eq in logement.equipements %}
                <li class="ld-equip-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    {{ eq }}
                </li>
                {% endfor %}
            </ul>
        </div>

        <hr class="ld-divider">

        <!-- Points d'intérêt -->
        <div class="ld-section">
            <h2 class="ld-section-title">À proximité</h2>
            <ul class="ld-poi">
                {% for poi in logement.points_interet %}
                <li class="ld-poi-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {{ poi }}
                </li>
                {% endfor %}
            </ul>
        </div>

    </div>

    <!-- COLONNE DROITE : carte réservation -->
    <aside class="ld-aside">
        <div class="ld-card">
            <div class="ld-card-price">
                <span class="ld-price-num">{{ logement.prix }} €</span>
                <span class="ld-price-unit"> / nuit</span>
            </div>
            <div class="ld-card-rating">
                <span>★ {{ logement.note }}</span>
                <span class="ld-sep">·</span>
                <span>{{ logement.avis }} avis</span>
            </div>

            <div class="ld-card-cta">
                <a href="https://wa.me/33600000000?text=Bonjour%2C+je+suis+int%C3%A9ress%C3%A9+par+{{ logement.nom|url_encode }}+%C3%A0+{{ logement.prix }}%E2%82%AC%2Fnuit" target="_blank" rel="noopener" class="btn-resa btn-whatsapp">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Réserver via WhatsApp
                </a>
                <p class="ld-card-note">Réponse sous 2h · Paiement sécurisé</p>
            </div>

            <hr class="ld-divider" style="margin: 20px 0;">

            <div class="ld-card-detail">
                <div class="ld-card-row">
                    <span>{{ logement.prix }} € × 1 nuit</span>
                    <span>{{ logement.prix }} €</span>
                </div>
                <div class="ld-card-row">
                    <span>Frais de ménage</span>
                    <span>inclus</span>
                </div>
                <div class="ld-card-row ld-card-row--total">
                    <span>Total</span>
                    <span>{{ logement.prix }} €</span>
                </div>
            </div>
        </div>
    </aside>

</div>

<!-- ══ AUTRES LOGEMENTS ══════════════════════════════════════ -->
{% if autres is not empty %}
<section class="ld-autres">
    <div class="lg-wrap">
        <h2 class="ld-autres-title">D'autres <em>belles adresses</em></h2>
        <div class="lg-grid ld-autres-grid">
            {% for autre in autres %}
            <a href="{{ path('app_logement_show', {slug: autre.slug}) }}" class="lg-card ld-card-link">
                <div class="lg-img lg-img--{{ autre.img_index }}">
                    <span class="lg-badge">{{ autre.type }}</span>
                    <span class="lg-rating">★ {{ autre.note }}</span>
                </div>
                <div class="lg-info">
                    <h3 class="lg-name">{{ autre.nom }}</h3>
                    <p class="lg-meta">{{ autre.quartier }} · {{ autre.voyageurs }} voyageurs · {{ autre.chambres }} ch.</p>
                    <p class="lg-price">{{ autre.prix }} € <span>/ nuit</span></p>
                </div>
            </a>
            {% endfor %}
        </div>
        <div class="ld-autres-cta">
            <a href="{{ path('app_logements') }}" class="btn-outline">Voir tous les logements</a>
        </div>
    </div>
</section>
{% endif %}

{% endblock %}
