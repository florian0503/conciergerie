{% extends 'base.html.twig' %}

{% block title %}{{ logement.nom }} — Les Clés Lyonnaises{% endblock %}
{% block meta_description %}{{ logement.description|slice(0, 155)|striptags }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/logements.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/logement-detail.css') }}">
{% endblock %}

{% block body %}

<div class="ld-wrap" style="max-width:1200px;margin:0 auto;padding:0 var(--gutter);">

    <!-- ══ BREADCRUMB ══════════════════════════════════════════ -->
    <div class="ld-breadcrumb-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <a class="breadcrumb-link" href="{{ path('app_logements') }}">Logements</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">{{ logement.nom }}</span>
        </nav>
    </div>

</div>

<!-- ══ GALERIE ════════════════════════════════════════════════ -->
<div style="max-width:1200px;margin:0 auto;padding:0 var(--gutter);">
    {% if logement.photos is not empty %}
    <div class="ld-galerie">
        <div class="ld-galerie-grid">

            <div class="ld-bg ld-galerie-main" data-lb="0" style="cursor:zoom-in;">
                <img class="ld-bg-img" src="{{ logement.photos[0] }}" alt="{{ logement.nom }}">
            </div>

            {% if logement.photos|length > 1 %}
            <div class="ld-galerie-side">
                {% for i in 1..4 %}
                {% if logement.photos[i] is defined %}
                <div class="ld-bg" data-lb="{{ i }}" style="cursor:zoom-in;">
                    <img class="ld-bg-img" src="{{ logement.photos[i] }}" alt="{{ logement.nom }} — photo {{ i + 1 }}">
                </div>
                {% else %}
                <div class="ld-bg" style="background:var(--paper-warm);"></div>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

        </div>
    </div>
    {% else %}
    <div class="ld-galerie" style="background:var(--paper-warm);border-radius:12px;display:flex;align-items:center;justify-content:center;">
        <p style="color:var(--ink-muted);font-family:var(--sans);font-size:14px;">Aucune photo disponible</p>
    </div>
    {% endif %}
</div>

<!-- ══ LIGHTBOX ═══════════════════════════════════════════════ -->
{% if logement.photos is not empty %}
<div class="ld-lb" id="ld-lb">
    <button class="ld-lb-close" id="ld-lb-close" aria-label="Fermer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="ld-lb-prev" id="ld-lb-prev" aria-label="Précédente">←</button>
    <div class="ld-lb-img" id="ld-lb-img"></div>
    <button class="ld-lb-next" id="ld-lb-next" aria-label="Suivante">→</button>
    <p class="ld-lb-counter" id="ld-lb-counter"></p>
</div>
{% endif %}

<!-- ══ EN-TÊTE + LAYOUT ═══════════════════════════════════════ -->
<div style="max-width:1200px;margin:0 auto;padding:0 var(--gutter);">

    <div class="ld-header">
        <div class="ld-header-meta">
            <span class="ld-badge">{{ logement.type }}</span>
            <span class="ld-quartier">{{ logement.quartier }}</span>
        </div>
        <h1 class="ld-title">{{ logement.nom }}</h1>
        <div class="ld-specs">
            <span class="ld-spec">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {{ logement.voyageurs }} voyageurs
            </span>
            <span class="ld-spec-dot">·</span>
            <span class="ld-spec">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {{ logement.chambres }} chambre{% if logement.chambres > 1 %}s{% endif %}
            </span>
            <span class="ld-spec-dot">·</span>
            <span class="ld-spec">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {{ logement.note }} ({{ logement.avis }} avis)
            </span>
        </div>
        {% if logement.occupation is not null %}
        <p class="ld-meta-occupation">{{ logement.occupation }}% d'occupation</p>
        {% endif %}
    </div>

    <hr class="ld-divider-full">

    <div class="ld-layout">

        <!-- ── COLONNE PRINCIPALE ──────────────────────────── -->
        <div class="ld-main">

            <!-- Description -->
            <div class="ld-section">
                <h2 class="ld-section-title">Le bien</h2>
                {% for para in logement.description|split('\n\n') %}
                <p class="ld-description">{{ para }}</p>
                {% endfor %}
            </div>

            <hr class="ld-divider">

            <!-- Ce qu'on gère -->
            <div class="ld-section">
                <h2 class="ld-section-title">Ce qu'on gère pour vous</h2>
                <p class="ld-section-intro">De la mise en ligne à la remise des clés — on s'occupe de tout.</p>
                <div class="ld-services-grid">
                    <div class="ld-service">
                        <div class="ld-service-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <div>
                            <p class="ld-service-title">Gestion des réservations</p>
                            <p class="ld-service-desc">Calendrier, tarification dynamique, synchronisation des plateformes.</p>
                        </div>
                    </div>
                    <div class="ld-service">
                        <div class="ld-service-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div>
                            <p class="ld-service-title">Accueil des voyageurs</p>
                            <p class="ld-service-desc">Check-in, check-out, remise des clés et communication 7j/7.</p>
                        </div>
                    </div>
                    <div class="ld-service">
                        <div class="ld-service-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                        </div>
                        <div>
                            <p class="ld-service-title">Ménage & linge</p>
                            <p class="ld-service-desc">Nettoyage professionnel entre chaque séjour, linge de qualité hôtelière.</p>
                        </div>
                    </div>
                    <div class="ld-service">
                        <div class="ld-service-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </div>
                        <div>
                            <p class="ld-service-title">Optimisation des revenus</p>
                            <p class="ld-service-desc">Tarifs ajustés en temps réel pour maximiser vos revenus locatifs.</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if logement.equipements is not empty %}
            <hr class="ld-divider">

            <!-- Équipements -->
            <div class="ld-section">
                <h2 class="ld-section-title">Équipements</h2>
                <ul class="ld-equipements">
                    {% for equip in logement.equipements %}
                    <li class="ld-equip-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                        {{ equip }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if logement.pointsInteret is not empty %}
            <hr class="ld-divider">

            <!-- Points d'intérêt -->
            <div class="ld-section">
                <h2 class="ld-section-title">À proximité</h2>
                <ul class="ld-poi">
                    {% for poi in logement.pointsInteret %}
                    <li class="ld-poi-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ poi }}
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

        </div>

        <!-- ── ASIDE ───────────────────────────────────────── -->
        <aside class="ld-aside">

            <!-- Performances -->
            <div class="ld-perf-card">
                <p class="ld-perf-label">Performances 2024</p>
                <div class="ld-perf-stats">
                    <div class="ld-stat">
                        <span class="ld-stat-num">★ {{ logement.note }}</span>
                        <span class="ld-stat-name">Note moyenne</span>
                    </div>
                    <div class="ld-stat">
                        <span class="ld-stat-num">{{ logement.avis }}</span>
                        <span class="ld-stat-name">Avis reçus</span>
                    </div>
                    <div class="ld-stat">
                        <span class="ld-stat-num">{{ logement.occupation }}%</span>
                        <span class="ld-stat-name">Taux d'occupation</span>
                    </div>
                    <div class="ld-stat">
                        <span class="ld-stat-num">{{ logement.revenus }}</span>
                        <span class="ld-stat-name">Revenus / mois</span>
                    </div>
                </div>
                <p class="ld-perf-note">Données à titre indicatif. Les résultats peuvent varier selon la période et le marché.</p>
            </div>

            <!-- CTA -->
            <div class="ld-cta-card">
                <h3 class="ld-cta-title">Vous avez un bien similaire ?</h3>
                <p class="ld-cta-text">Confiez-nous sa gestion et profitez de revenus optimisés, sans les contraintes.</p>
                <a href="{{ path('app_contact') }}" class="ld-cta-btn">
                    Nous contacter
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="8" x2="13" y2="8"/><polyline points="9 4 13 8 9 12"/></svg>
                </a>
                <p class="ld-cta-note">Réponse sous 24h</p>
            </div>

        </aside>

    </div>
</div>

<!-- ══ AUTRES LOGEMENTS ═══════════════════════════════════════ -->
{% if autres is not empty %}
<section class="ld-autres">
    <div style="max-width:1200px;margin:0 auto;padding:0 var(--gutter);">
        <h2 class="ld-autres-title">D'autres biens<br>à <em>découvrir</em>.</h2>
        <div class="lg-grid ld-autres-grid">
            {% for a in autres %}
            <a href="{{ path('app_logement_show', {slug: a.slug}) }}" class="lg-card ld-card-link">
                <div class="lg-img lg-img--{{ a.imgIndex }}">
                    <span class="lg-badge">{{ a.type }}</span>
                    <span class="lg-rating">★ {{ a.note }}</span>
                </div>
                <div class="lg-info">
                    <h3 class="lg-name">{{ a.nom }}</h3>
                    <p class="lg-meta">{{ a.quartier }} · {{ a.voyageurs }} voyageurs · {{ a.chambres }} ch.</p>
                </div>
            </a>
            {% endfor %}
        </div>
        <div class="ld-autres-cta">
            <a href="{{ path('app_logements') }}" class="btn-outline">Voir tous nos logements</a>
        </div>
    </div>
</section>
{% endif %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if logement.photos is not empty %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var photos = {{ logement.photos|json_encode|raw }};
    if (!photos.length) return;

    var lb      = document.getElementById('ld-lb');
    var lbImg   = document.getElementById('ld-lb-img');
    var lbClose = document.getElementById('ld-lb-close');
    var lbPrev  = document.getElementById('ld-lb-prev');
    var lbNext  = document.getElementById('ld-lb-next');
    var lbCount = document.getElementById('ld-lb-counter');
    var cur = 0;

    function open(idx) {
        cur = ((idx % photos.length) + photos.length) % photos.length;
        lbImg.style.backgroundImage = 'url(' + photos[cur] + ')';
        lbCount.textContent = (cur + 1) + ' / ' + photos.length;
        lb.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        lb.classList.remove('is-open');
        document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-lb]').forEach(function (el) {
        el.addEventListener('click', function () { open(+el.getAttribute('data-lb')); });
    });

    lbClose.addEventListener('click', close);
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    lbPrev.addEventListener('click', function () { open(cur - 1); });
    lbNext.addEventListener('click', function () { open(cur + 1); });

    document.addEventListener('keydown', function (e) {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') open(cur - 1);
        if (e.key === 'ArrowRight') open(cur + 1);
    });
});
</script>
{% endif %}
{% endblock %}
