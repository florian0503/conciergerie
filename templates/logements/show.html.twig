{% extends 'base.html.twig' %}

{% block title %}{{ logement.nom }} — Maison Mathis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/logements.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/logement-detail.css') }}">
{% endblock %}

{% block body %}

<!-- ══ BREADCRUMB ════════════════════════════════════════════ -->
<div class="ld-breadcrumb-wrap lg-wrap">
    <nav class="breadcrumb" aria-label="Fil d'ariane">
        <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
        <span class="breadcrumb-sep">／</span>
        <a class="breadcrumb-link" href="{{ path('app_logements') }}">Logements</a>
        <span class="breadcrumb-sep">／</span>
        <span class="breadcrumb-current">{{ logement.nom }}</span>
    </nav>
</div>

<!-- ══ GALERIE ══════════════════════════════════════════════ -->
<section class="ld-galerie">
    <div class="ld-galerie-grid">
        <div class="ld-galerie-main ld-bg ld-lightbox-trigger" data-img="{{ logement.photos[0] }}">
            <img src="{{ logement.photos[0] }}" alt="{{ logement.nom }}" class="ld-bg-img">
        </div>
        <div class="ld-galerie-side">
            <div class="ld-bg ld-lightbox-trigger" data-img="{{ logement.photos[1] }}"><img src="{{ logement.photos[1] }}" alt="{{ logement.nom }}" class="ld-bg-img"></div>
            <div class="ld-bg ld-lightbox-trigger" data-img="{{ logement.photos[2] }}"><img src="{{ logement.photos[2] }}" alt="{{ logement.nom }}" class="ld-bg-img"></div>
            <div class="ld-bg ld-lightbox-trigger" data-img="{{ logement.photos[3] }}"><img src="{{ logement.photos[3] }}" alt="{{ logement.nom }}" class="ld-bg-img"></div>
            <div class="ld-bg ld-lightbox-trigger" data-img="{{ logement.photos[4] }}"><img src="{{ logement.photos[4] }}" alt="{{ logement.nom }}" class="ld-bg-img"></div>
        </div>
    </div>
</section>

<!-- ══ LIGHTBOX ══════════════════════════════════════════════ -->
<div class="ld-lb" id="ld-lb" aria-hidden="true">
    <button class="ld-lb-close" id="ld-lb-close" aria-label="Fermer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="ld-lb-prev" id="ld-lb-prev" aria-label="Précédent">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="ld-lb-img" id="ld-lb-img"></div>
    <button class="ld-lb-next" id="ld-lb-next" aria-label="Suivant">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="ld-lb-counter" id="ld-lb-counter"></div>
</div>

<!-- ══ EN-TÊTE DU BIEN ══════════════════════════════════════ -->
<div class="ld-header lg-wrap">
    <div class="ld-header-row">

        <div>
            <div class="ld-header-meta">
                <span class="ld-badge">{{ logement.type }}</span>
                <span class="ld-quartier">{{ logement.quartier }}</span>
            </div>
            <h1 class="ld-title">{{ logement.nom }}</h1>
            <div class="ld-specs">
                <span class="ld-spec">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    {{ logement.voyageurs }} voyageurs
                </span>
                <span class="ld-spec-dot">·</span>
                <span class="ld-spec">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    {{ logement.chambres }} chambre{{ logement.chambres > 1 ? 's' : '' }}
                </span>
                <span class="ld-spec-dot">·</span>
                <span class="ld-spec">★ {{ logement.note }} ({{ logement.avis }} avis)</span>
            </div>
        </div>
    </div>
</div>

<div class="ld-divider-full"></div>

<!-- ══ CORPS ════════════════════════════════════════════════ -->
<div class="ld-layout lg-wrap">

    <!-- ── COLONNE PRINCIPALE ──────────────────────────────── -->
    <div class="ld-main">

        <!-- Description -->
        <div class="ld-section">
            <h2 class="ld-section-title">Le logement</h2>
            <p class="ld-description">{{ logement.description }}</p>
        </div>

        <hr class="ld-divider">

        <!-- Ce que nous gérons -->
        <div class="ld-section">
            <h2 class="ld-section-title">Ce que nous gérons pour ce bien</h2>
            <p class="ld-section-intro">Maison Mathis prend en charge l'intégralité de la gestion locative, du premier voyageur au dernier avis.</p>
            <div class="ld-services-grid">
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Accueil des voyageurs</h3>
                        <p class="ld-service-desc">Remise des clés, état des lieux, présentation du logement. Disponibles 7j/7.</p>
                    </div>
                </div>
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Ménage & linge</h3>
                        <p class="ld-service-desc">Nettoyage professionnel entre chaque séjour, fourniture du linge de maison hôtelier.</p>
                    </div>
                </div>
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Communication Airbnb</h3>
                        <p class="ld-service-desc">Gestion des messages, réponses rapides, optimisation des avis et du classement.</p>
                    </div>
                </div>
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Gestion des imprévus</h3>
                        <p class="ld-service-desc">Intervention rapide en cas de problème : plomberie, serrurerie, électroménager.</p>
                    </div>
                </div>
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Optimisation des revenus</h3>
                        <p class="ld-service-desc">Tarification dynamique, gestion du calendrier, analyse du marché local pour maximiser vos gains.</p>
                    </div>
                </div>
                <div class="ld-service">
                    <div class="ld-service-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </div>
                    <div>
                        <h3 class="ld-service-title">Reporting mensuel</h3>
                        <p class="ld-service-desc">Bilan complet chaque mois : revenus, taux d'occupation, avis reçus, dépenses engagées.</p>
                    </div>
                </div>
            </div>
        </div>

        <hr class="ld-divider">

        <!-- Équipements -->
        <div class="ld-section">
            <h2 class="ld-section-title">Équipements du bien</h2>
            <ul class="ld-equipements">
                {% for eq in logement.equipements %}
                <li class="ld-equip-item">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    {{ eq }}
                </li>
                {% endfor %}
            </ul>
        </div>

        <hr class="ld-divider">

        <!-- Points d'intérêt -->
        <div class="ld-section">
            <h2 class="ld-section-title">À proximité</h2>
            <ul class="ld-poi">
                {% for poi in logement.points_interet %}
                <li class="ld-poi-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    {{ poi }}
                </li>
                {% endfor %}
            </ul>
        </div>

    </div>

    <!-- ── COLONNE DROITE : perf + CTA ────────────────────── -->
    <aside class="ld-aside">

        <!-- Chiffres de performance -->
        <div class="ld-perf-card">
            <p class="ld-perf-label">Performances de ce bien</p>
            <div class="ld-perf-stats">
                <div class="ld-stat">
                    <span class="ld-stat-num">{{ logement.occupation }} %</span>
                    <span class="ld-stat-name">Taux d'occupation</span>
                </div>
                <div class="ld-stat">
                    <span class="ld-stat-num">{{ logement.revenus }} €</span>
                    <span class="ld-stat-name">Revenus / mois</span>
                </div>
                <div class="ld-stat">
                    <span class="ld-stat-num">★ {{ logement.note }}</span>
                    <span class="ld-stat-name">Note moyenne</span>
                </div>
                <div class="ld-stat">
                    <span class="ld-stat-num">{{ logement.avis }}</span>
                    <span class="ld-stat-name">Avis clients</span>
                </div>
            </div>
            <p class="ld-perf-note">Données moyennes sur les 12 derniers mois.</p>
        </div>

        <!-- CTA confier -->
        <div class="ld-cta-card">
            <h3 class="ld-cta-title">Vous avez un bien similaire ?</h3>
            <p class="ld-cta-text">Confiez-nous sa gestion. On s'occupe de tout, vous percevez vos revenus.</p>
            <a href="{{ path('app_home') }}#contact" class="ld-cta-btn">
                Parlons de votre bien
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <p class="ld-cta-note">Estimation gratuite · Sans engagement</p>
        </div>

    </aside>

</div>

<!-- ══ AUTRES LOGEMENTS ══════════════════════════════════════ -->
{% if autres is not empty %}
<section class="ld-autres">
    <div class="lg-wrap">
        <h2 class="ld-autres-title">D'autres <em>belles adresses</em></h2>
        <div class="lg-grid ld-autres-grid">
            {% for autre in autres %}
            <a href="{{ path('app_logement_show', {slug: autre.slug}) }}" class="lg-card ld-card-link">
                <div class="lg-img lg-img--{{ autre.img_index }}">
                    <span class="lg-badge">{{ autre.type }}</span>
                    <span class="lg-rating">★ {{ autre.note }}</span>
                </div>
                <div class="lg-info">
                    <h3 class="lg-name">{{ autre.nom }}</h3>
                    <p class="lg-meta">{{ autre.quartier }} · {{ autre.voyageurs }} voyageurs · {{ autre.chambres }} ch.</p>
                    <p class="lg-meta ld-meta-occupation">{{ autre.occupation }} % d'occupation</p>
                </div>
            </a>
            {% endfor %}
        </div>
        <div class="ld-autres-cta">
            <a href="{{ path('app_logements') }}" class="btn-outline">Voir tous les logements</a>
        </div>
    </div>
</section>
{% endif %}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var triggers = Array.from(document.querySelectorAll('.ld-lightbox-trigger'));
    var lb       = document.getElementById('ld-lb');
    var lbImg    = document.getElementById('ld-lb-img');
    var lbClose  = document.getElementById('ld-lb-close');
    var lbPrev   = document.getElementById('ld-lb-prev');
    var lbNext   = document.getElementById('ld-lb-next');
    var lbCount  = document.getElementById('ld-lb-counter');
    var current  = 0;

    function open(index) {
        current = index;
        var url = triggers[index].getAttribute('data-img');
        lbImg.style.backgroundImage = 'url(' + url + ')';
        lbCount.textContent = (index + 1) + ' / ' + triggers.length;
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function prev() { open((current - 1 + triggers.length) % triggers.length); }
    function next() { open((current + 1) % triggers.length); }

    triggers.forEach(function (el, i) {
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', function () { open(i); });
    });

    lbClose.addEventListener('click', close);
    lbPrev.addEventListener('click', prev);
    lbNext.addEventListener('click', next);

    lb.addEventListener('click', function (e) {
        if (e.target === lb) close();
    });

    document.addEventListener('keydown', function (e) {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape')     close();
        if (e.key === 'ArrowLeft')  prev();
        if (e.key === 'ArrowRight') next();
    });
});
</script>
{% endblock %}
