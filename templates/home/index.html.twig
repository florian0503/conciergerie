{% extends 'base.html.twig' %}

{% block title %}Maison Mathis — Conciergerie Airbnb premium à Lyon{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block body %}

<!-- ═══════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════ -->
<section class="hero">
    <div class="hero-inner">
        <div class="hero-left">
            <p class="hero-eyebrow"><span>Conciergerie Airbnb</span><span class="sep">·</span><span>Lyon</span></p>
            <h1 class="hero-title">
                Votre bien,<br>
                entre <em>les<br>meilleures</em><br>
                mains de Lyon.
            </h1>
            <p class="hero-desc">Nous gérons votre location courte durée de A à Z — annonces, voyageurs, ménage, revenus — pendant que vous profitez de tout le reste.</p>
            <div class="hero-actions">
                <a href="{{ path('app_offres') }}" class="btn btn--primary">Estimer mes revenus →</a>
                <a href="{{ path('app_services') }}" class="btn btn--ghost">Découvrir nos services</a>
            </div>
        </div>
        <div class="hero-right">
            <div class="hero-img-wrap">
                <div class="hero-img-placeholder"></div>
                <div class="hero-badge">
                    <span class="hero-badge-stars">★★★★★</span>
                    <span class="hero-badge-text">4.94 · Note moyenne voyageurs</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     TICKER QUARTIERS
════════════════════════════════════════════════════════════ -->
<div class="quartiers-ticker" aria-hidden="true">
    <p class="quartiers-label">Nous opérons</p>
    <div class="quartiers-overflow">
        <div class="quartiers-track">
            {% for quartier in quartiers %}
            <span>{{ quartier.nom }}</span><span class="q-sep">✦</span>
            {% endfor %}
            {% for quartier in quartiers %}
            <span>{{ quartier.nom }}</span><span class="q-sep">✦</span>
            {% endfor %}
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     STATS
════════════════════════════════════════════════════════════ -->
<section class="stats">
    <div class="stats-inner">
        <div class="stat-item">
            <p class="stat-number" data-target="34" data-prefix="+">+34<span class="stat-sup">%</span></p>
            <p class="stat-label">de revenus en moyenne<br>pour nos propriétaires</p>
        </div>
        <div class="stat-item">
            <p class="stat-number" data-target="4.94" data-decimals="2">4.94<span class="stat-sup">★</span></p>
            <p class="stat-label">note moyenne<br>voyageurs</p>
        </div>
        <div class="stat-item">
            <p class="stat-number" data-target="120">120<span class="stat-sup">+</span></p>
            <p class="stat-label">biens gérés<br>à Lyon et alentour</p>
        </div>
        <div class="stat-item">
            <p class="stat-number" data-target="15">15<span class="stat-sup">min</span></p>
            <p class="stat-label">temps de réponse moyen<br>aux voyageurs</p>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     SERVICES
════════════════════════════════════════════════════════════ -->
<section class="services">
    <div class="section-inner">
        <div class="section-head">
            <div class="section-head-left">
                <p class="eyebrow">Nos services</p>
                <h2 class="section-title">Tout ce qu'il faut<br>pour louer <em>sereinement.</em></h2>
            </div>
            <a href="{{ path('app_services') }}" class="link-arrow">Détail des services →</a>
        </div>

        <div class="services-grid">
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">01</span>
                    <h3 class="service-name service-name--active">Création &amp; optimisation des annonces</h3>
                </div>
                <p class="service-desc">Photos, descriptions, tarifs dynamiques. Nous construisons des annonces qui convertissent et remontent dans les résultats.</p>
            </div>
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">02</span>
                    <h3 class="service-name">Réponses aux voyageurs</h3>
                </div>
                <p class="service-desc">Communication 7/7, en français et en anglais. Réactivité sous 15 minutes en moyenne.</p>
            </div>
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">03</span>
                    <h3 class="service-name">Arrivées &amp; départs</h3>
                </div>
                <p class="service-desc">Remise de clés, accueil, check-out. Une expérience soignée de bout en bout.</p>
            </div>
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">04</span>
                    <h3 class="service-name">Assistance pendant le séjour</h3>
                </div>
                <p class="service-desc">Nous sommes le point de contact unique pour tous les imprévus, 24/7.</p>
            </div>
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">05</span>
                    <h3 class="service-name">Ménage &amp; linge hôtelier</h3>
                </div>
                <p class="service-desc">Prestataires certifiés, linge plat livré, produits premium. Qualité hôtel à chaque rotation.</p>
            </div>
            <div class="service-item">
                <div class="service-top">
                    <span class="service-num">06</span>
                    <h3 class="service-name">Suivi qualité</h3>
                </div>
                <p class="service-desc">Contrôle après chaque séjour, rapports d'état, maintenance préventive.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     ENGAGEMENT (dark)
════════════════════════════════════════════════════════════ -->
<section class="engagement">
    <div class="section-inner">
        <p class="eyebrow eyebrow--light">Notre engagement</p>
        <blockquote class="engagement-quote">
            Nous prenons soin de votre bien<br>
            <em>comme du nôtre</em> — et de vos voyageurs<br>
            comme de nos invités.
        </blockquote>
        <div class="engagement-rule"></div>
        <p class="engagement-sig">— Sierra Mathis, fondateur</p>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     LOGEMENTS
════════════════════════════════════════════════════════════ -->
<section class="listings">
    <div class="section-inner">
        <div class="section-head">
            <div class="section-head-left">
                <h2 class="section-title">Une sélection de<br><em>belles adresses.</em></h2>
            </div>
            <a href="{{ path('app_logements') }}" class="link-arrow listings-link--desktop">Voir toute la galerie →</a>
        </div>
        <div class="listings-grid">
            <div class="listing-card listing-card--large">
                <div class="listing-img listing-img--1"></div>
                <div class="listing-info">
                    <p class="listing-name">Éliane Park</p>
                    <p class="listing-meta">Vieux Lyon · Maison · 8 voyageurs</p>
                </div>
            </div>
            <div class="listing-card">
                <div class="listing-img listing-img--2"></div>
                <div class="listing-info">
                    <p class="listing-name">Atelier Croix-Rousse</p>
                    <p class="listing-meta">Croix-Rousse · Loft · 4 voyageurs</p>
                </div>
            </div>
            <div class="listing-card listing-card--bottom-left">
                <div class="listing-img listing-img--3"></div>
                <div class="listing-info">
                    <p class="listing-name">La Presqu'île</p>
                    <p class="listing-meta">Presqu'île · Appartement · 2 voyageurs</p>
                </div>
            </div>
            <div class="listing-card">
                <div class="listing-img listing-img--4"></div>
                <div class="listing-info">
                    <p class="listing-name">Source Confluence</p>
                    <p class="listing-meta">Confluence · Studio · 2 voyageurs</p>
                </div>
            </div>
            <div class="listing-card">
                <div class="listing-img listing-img--5"></div>
                <div class="listing-info">
                    <p class="listing-name">Rive de Saône</p>
                    <p class="listing-meta">Vieux Lyon · Duplex · 5 voyageurs</p>
                </div>
            </div>
        </div>
        <a href="{{ path('app_logements') }}" class="link-arrow listings-link--mobile">Voir toute la galerie →</a>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     PROCESS
════════════════════════════════════════════════════════════ -->
<section class="process">
    <div class="section-inner">
        <p class="eyebrow">Comment ça marche</p>
        <h2 class="section-title">De la première visite<br>au premier voyageur.</h2>

        <div class="process-steps">
            <div class="process-step">
                <div class="step-circle">01</div>
                <div class="step-line"></div>
                <h3 class="step-title">Rencontre</h3>
                <p class="step-desc">Visite du bien, échange sur vos attentes, estimation des revenus et proposition détaillée.</p>
            </div>
            <div class="process-step">
                <div class="step-circle">02</div>
                <div class="step-line"></div>
                <h3 class="step-title">Mise en scène</h3>
                <p class="step-desc">Home staging léger, shooting photo professionnel, rédaction des annonces.</p>
            </div>
            <div class="process-step">
                <div class="step-circle">03</div>
                <div class="step-line"></div>
                <h3 class="step-title">Lancement</h3>
                <p class="step-desc">Paramétrage Airbnb, Booking, Vrbo. Tarification dynamique et calendrier synchronisé.</p>
            </div>
            <div class="process-step">
                <div class="step-circle">04</div>
                <h3 class="step-title">Exploitation</h3>
                <p class="step-desc">Nous gérons tout. Vous recevez vos reportings mensuels et vos virements — c'est tout.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     AVIS
════════════════════════════════════════════════════════════ -->
<section class="reviews">
    <div class="section-inner">
        <div class="section-head">
            <div class="section-head-left">
                <p class="eyebrow">Ils nous confient leur bien</p>
                <h2 class="section-title">Propriétaires <em>sereins.</em></h2>
            </div>
            <a href="{{ path('app_avis') }}" class="link-arrow">Lire tous les avis →</a>
        </div>
        <div class="reviews-grid">
            {% for a in avis %}
            <div class="review-card">
                <p class="review-stars">{% for i in 1..a.note %}★{% endfor %}</p>
                <blockquote class="review-text">"{{ a.texte }}"</blockquote>
                <div class="review-author">
                    <span class="review-name">{{ a.nom }}</span>
                    <span class="review-sep">·</span>
                    <span class="review-role">{{ a.role }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     CTA FINAL
════════════════════════════════════════════════════════════ -->
<section class="cta-final">
    <div class="cta-final-inner">
        <h2 class="cta-final-title">
            Parlons de votre bien.<br>
            Sans engagement, en <em>toute<br>confiance.</em>
        </h2>
        <p class="cta-final-desc">Un échange de 20 minutes pour comprendre votre projet, estimer vos revenus et voir si nous sommes faits pour travailler ensemble.</p>
        <div class="cta-final-actions">
            <a href="#" class="btn btn--primary">Prendre rendez-vous →</a>
            <a href="{{ path('app_offres') }}" class="btn btn--outline">Nos tarifs</a>
        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* ── Reviews carousel infini (mobile) ── */
    if (window.innerWidth <= 600) {
        var grid = document.querySelector('.reviews-grid');
        var orig = grid ? Array.from(grid.querySelectorAll('.review-card')) : [];
        if (grid && orig.length > 1) {
            var total = orig.length;

            /* clones pour l'effet infini */
            var clonePrev = orig[total - 1].cloneNode(true);
            var cloneNext = orig[0].cloneNode(true);
            grid.insertBefore(clonePrev, orig[0]);
            grid.appendChild(cloneNext);
            var all = Array.from(grid.querySelectorAll('.review-card'));

            var cur = 1; /* on commence sur la vraie 1ère carte */
            var jumping = false;
            var timer;

            /* dots */
            var dotsWrap = document.createElement('div');
            dotsWrap.className = 'reviews-dots';
            for (var d = 0; d < total; d++) {
                var dot = document.createElement('button');
                dot.className = 'reviews-dot' + (d === 0 ? ' is-active' : '');
                dot.setAttribute('aria-label', 'Avis ' + (d + 1));
                (function(i) {
                    dot.addEventListener('click', function () { slideTo(i + 1, true); resetTimer(); });
                })(d);
                dotsWrap.appendChild(dot);
            }
            grid.parentNode.insertBefore(dotsWrap, grid.nextSibling);
            var dots = dotsWrap.querySelectorAll('.reviews-dot');

            function centerOf(idx) {
                var c = all[idx];
                return c.offsetLeft - (grid.offsetWidth - c.offsetWidth) / 2;
            }

            function updateDots(idx) {
                var real = ((idx - 1) % total + total) % total;
                dots.forEach(function (d, i) { d.classList.toggle('is-active', i === real); });
            }

            function slideTo(idx, animate) {
                cur = idx;
                if (animate === false) {
                    jumping = true;
                    grid.scrollLeft = centerOf(idx);
                    jumping = false;
                } else {
                    grid.scrollTo({ left: centerOf(idx), behavior: 'smooth' });
                }
                updateDots(idx);
            }

            /* position initiale sans animation */
            slideTo(1, false);

            function next() {
                var nextIdx = cur + 1;
                slideTo(nextIdx, true);
                if (nextIdx === all.length - 1) {
                    setTimeout(function () { slideTo(1, false); }, 420);
                }
            }

            function resetTimer() {
                clearInterval(timer);
                timer = setInterval(next, 3500);
            }

            resetTimer();

            /* swipe manuel */
            var tx = 0;
            grid.addEventListener('touchstart', function (e) {
                clearInterval(timer);
                tx = e.touches[0].clientX;
            }, { passive: true });
            grid.addEventListener('touchend', function (e) {
                var dx = tx - e.changedTouches[0].clientX;
                if (Math.abs(dx) > 40) {
                    var nextI = cur + (dx > 0 ? 1 : -1);
                    slideTo(nextI, true);
                    if (nextI === all.length - 1) setTimeout(function () { slideTo(1, false); }, 420);
                    if (nextI === 0)              setTimeout(function () { slideTo(total, false); }, 420);
                }
                resetTimer();
            }, { passive: true });
        }
    }

    var stats = document.querySelectorAll('.stat-number[data-target]');

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                animateStat(entry.target);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.6 });

    stats.forEach(function (el) { observer.observe(el); });

    function animateStat(el) {
        var target   = parseFloat(el.dataset.target);
        var decimals = parseInt(el.dataset.decimals || '0');
        var prefix   = el.dataset.prefix || '';
        var sup      = el.querySelector('.stat-sup');
        var supHtml  = sup ? sup.outerHTML : '';
        var duration = 1600;
        var startTs  = null;

        function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

        function tick(ts) {
            if (!startTs) startTs = ts;
            var progress = Math.min((ts - startTs) / duration, 1);
            var value    = easeOut(progress) * target;
            var display  = decimals > 0 ? value.toFixed(decimals) : Math.round(value);
            el.innerHTML = prefix + display + supHtml;
            if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
    }
});
</script>
{% endblock %}
