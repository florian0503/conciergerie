{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} — Les Clés Lyonnaises{% endblock %}
{% block meta_description %}{{ article.excerpt|slice(0, 155) }}{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title|json_encode|raw }},
    "description": {{ article.excerpt|json_encode|raw }},
    "author": {
        "@type": "Person",
        "name": {{ article.author|json_encode|raw }}
    },
    "publisher": {
        "@type": "Organization",
        "name": "Les Clés Lyonnaises",
        "logo": {
            "@type": "ImageObject",
            "url": "{{ app.request.schemeAndHttpHost }}/images/logo.png"
        }
    },
    "url": "{{ url('app_blog_article', {slug: article.slug}) }}",
    {% if article.img %}"image": "{{ app.request.schemeAndHttpHost }}{{ article.img }}",{% endif %}
    "inLanguage": "fr-FR",
    "keywords": "conciergerie lyon, location courte durée lyon, {{ article.tag }}"
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ url('app_home') }}"},
        {"@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ url('app_blog') }}"},
        {"@type": "ListItem", "position": 3, "name": {{ article.title|json_encode|raw }}, "item": "{{ url('app_blog_article', {slug: article.slug}) }}"}
    ]
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/blog.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO ARTICLE ═════════════════════════════════════════ -->
<section class="bl-hero">
    <div class="bl-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-link">À propos</span>
            <span class="breadcrumb-sep">／</span>
            <a class="breadcrumb-link" href="{{ path('app_blog') }}">Blog</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">{{ article.tag }}</span>
        </nav>
        <span class="bl-tag bl-tag--hero">{{ article.tag }}</span>
        <h1 class="bl-article-title">{{ article.title }}</h1>
        <div class="bl-article-meta">
            <span>{{ article.author }}</span>
            <span class="bl-meta-sep">·</span>
            <span>{{ article.date }}</span>
            <span class="bl-meta-sep">·</span>
            <span>{{ article.readTime }}</span>
        </div>
    </div>
</section>

<!-- ══ IMAGE COVER ══════════════════════════════════════════ -->
<div class="bl-article-cover">
    <div class="bl-wrap">
        <img class="bl-article-cover-img" src="{{ article.img }}" alt="{{ article.title }}" loading="lazy">
    </div>
</div>

<!-- ══ CONTENU ══════════════════════════════════════════════ -->
<article class="bl-article-body">
    <div class="bl-wrap">
        <div class="bl-article-inner">

            {% for block in article.content %}
                {% if block is iterable %}
                    {% if block.type == 'lead' %}
                        <p class="bl-article-lead">{{ block.text }}</p>
                    {% elseif block.type == 'h2' %}
                        <h2 class="bl-article-h2">{{ block.text }}</h2>
                    {% elseif block.type == 'p' %}
                        <p class="bl-article-p">{{ block.text }}</p>
                    {% endif %}
                {% else %}
                    <p class="bl-article-p">{{ block }}</p>
                {% endif %}
            {% endfor %}

        </div>
    </div>
</article>

<!-- ══ ARTICLES CONNEXES ════════════════════════════════════ -->
{% if related %}
<section class="bl-related">
    <div class="bl-wrap">
        <p class="bl-related-label">À lire aussi</p>
        <div class="bl-grid">
            {% for r in related %}
            <article class="bl-card">
                <a href="{{ path('app_blog_article', {slug: r.slug}) }}" class="bl-card-img-link">
                    <img class="bl-card-img" src="{{ r.img }}" alt="{{ r.title }}" loading="lazy">
                </a>
                <span class="bl-card-tag">{{ r.tag }}</span>
                <h3 class="bl-card-title">
                    <a href="{{ path('app_blog_article', {slug: r.slug}) }}">{{ r.title }}</a>
                </h3>
                <p class="bl-card-excerpt">{{ r.excerpt }}</p>
                <div class="bl-card-meta">
                    <span>{{ r.date }}</span>
                    <span class="bl-card-meta-sep">·</span>
                    <span>{{ r.readTime }}</span>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- ══ CTA ══════════════════════════════════════════════════ -->
<section class="bl-newsletter">
    <div class="bl-newsletter-inner">
        <span class="bl-newsletter-eyebrow">Newsletter</span>
        <h2 class="bl-newsletter-title">Un article par mois,<br><em>zéro bruit.</em></h2>
        <p class="bl-newsletter-desc">Nos meilleurs conseils, les chiffres du marché lyonnais et nos retours terrain — directement dans votre boîte mail.</p>
        <form class="bl-newsletter-form" action="#" method="post">
            <input class="bl-newsletter-input" type="email" name="email" placeholder="votre@email.fr" required aria-label="Votre adresse email">
            <button class="bl-newsletter-btn" type="submit">S'abonner →</button>
        </form>
    </div>
</section>

{% endblock %}
