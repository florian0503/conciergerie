{% extends 'base.html.twig' %}

{% block title %}FAQ — Maison Mathis{% endblock %}
{% block meta_description %}Toutes vos questions sur la gestion locative courte durée à Lyon. Frais, engagement, revenus, ménage, voyageurs — Maison Mathis répond sans jargon.{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/faq.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO ════════════════════════════════════════════════ -->
<section class="fq-hero">
    <div class="fq-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-link">À propos</span>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">FAQ</span>
        </nav>
        <h1 class="fq-title">Vos questions,<br><em>nos réponses.</em></h1>
        <p class="fq-subtitle">Tout ce que vous voulez savoir avant de nous confier votre bien — sans filtre, sans jargon.</p>
    </div>
</section>

<!-- ══ BODY ════════════════════════════════════════════════ -->
<section class="fq-body">
    <div class="fq-wrap">
        <div class="fq-body-inner">

            <!-- Sidebar nav -->
            <nav class="fq-nav" aria-label="Sections FAQ">
                <a href="#general" class="fq-nav-link is-active">Général</a>
                <a href="#tarifs" class="fq-nav-link">Tarifs</a>
                <a href="#menage" class="fq-nav-link">Ménage</a>
                <a href="#contrat" class="fq-nav-link">Contrat</a>
            </nav>

            <!-- Sections -->
            {% set cat_labels = {general: 'Général', tarifs: 'Tarifs', menage: 'Ménage', contrat: 'Contrat'} %}
            <div class="fq-sections">

                {% for cat_key, items in categories %}
                <div id="{{ cat_key }}">
                    <p class="fq-section-title">{{ cat_labels[cat_key] ?? cat_key|capitalize }}</p>
                    <div class="fq-list">
                        {% for item in items %}
                        <div class="fq-item">
                            <button class="fq-question" aria-expanded="false">
                                <span class="fq-question-text">{{ item.question }}</span>
                                <span class="fq-icon" aria-hidden="true">
                                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="6" y1="1" x2="6" y2="11"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
                                </span>
                            </button>
                            <div class="fq-answer">
                                {% for line in item.reponse|split('\n\n') %}
                                    <p>{{ line }}</p>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}

            </div>
        </div>
    </div>
</section>

<!-- ══ CTA ══════════════════════════════════════════════════ -->
<section class="fq-cta">
    <div class="fq-cta-inner">
        <h2 class="fq-cta-title">Vous n'avez pas trouvé<br><em>votre réponse ?</em></h2>
        <p class="fq-cta-desc">Contactez-nous directement — nous répondons en moins de 24h, et souvent bien avant.</p>
        <div class="fq-cta-actions">
            <a href="mailto:hello@maisonmathis.fr" class="btn btn--primary">Nous écrire →</a>
            <a href="{{ path('app_offres') }}" class="btn btn--outline">Voir les tarifs</a>
        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    /* ── ACCORDION ─────────────────────────────────────────── */
    document.querySelectorAll('.fq-question').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var item = btn.closest('.fq-item');
            var isOpen = item.classList.contains('is-open');
            item.classList.toggle('is-open', !isOpen);
            btn.setAttribute('aria-expanded', !isOpen);
        });
    });

    /* ── SIDEBAR ACTIVE ────────────────────────────────────── */
    var sections = document.querySelectorAll('.fq-sections > div[id]');
    var navLinks = document.querySelectorAll('.fq-nav-link');

    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                navLinks.forEach(function (l) { l.classList.remove('is-active'); });
                var active = document.querySelector('.fq-nav-link[href="#' + entry.target.id + '"]');
                if (active) active.classList.add('is-active');
            }
        });
    }, { rootMargin: '-30% 0px -60% 0px' });

    sections.forEach(function (s) { observer.observe(s); });
});
</script>
{% endblock %}
