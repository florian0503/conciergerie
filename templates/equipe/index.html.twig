{% extends 'base.html.twig' %}

{% block title %}L'Équipe — Maison Mathis{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/equipe.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO ════════════════════════════════════════════════ -->
<section class="eq-hero">
    <div class="eq-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-link">À propos</span>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">L'équipe</span>
        </nav>
        <h1 class="eq-title">
            Des visages,<br>
            pas des <em>numéros</em>.
        </h1>
        <p class="eq-subtitle">Quatre personnes, quatre métiers complémentaires, une seule promesse&nbsp;: vous connaître par votre prénom et votre bien par cœur.</p>
    </div>
</section>

<!-- ══ GRILLE ÉQUIPE ══════════════════════════════════════ -->
<section class="eq-grid-section">
    <div class="eq-wrap">
        <div class="eq-grid">

            {% for membre in membres %}
            <article class="eq-card reveal" data-delay="{{ loop.index }}">
                <div class="eq-photo eq-photo--{{ membre.photoSlug }}"></div>
                <div class="eq-info">
                    <p class="eq-role">{{ membre.role }}</p>
                    <h2 class="eq-name">{{ membre.nom }}</h2>
                    <p class="eq-bio">{{ membre.bio }}</p>
                    <div class="eq-tags">
                        {% for tag in membre.tags %}
                        <span class="eq-tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                </div>
            </article>
            {% endfor %}

        </div>
    </div>
</section>

<!-- ══ CTA REJOIGNEZ-NOUS ═════════════════════════════════ -->
<section class="eq-cta">
    <div class="eq-cta-inner">
        <p class="eyebrow">Rejoignez-nous</p>
        <h2 class="eq-cta-title">Nous recrutons des passionnés du service.</h2>
        <p class="eq-cta-desc">Si vous aimez Lyon, l'hospitalité et le travail bien fait, écrivez-nous.</p>
        <a href="mailto:hello@maisonmathis.fr" class="eq-cta-btn">hello@maisonmathis.fr</a>
    </div>
</section>

{% endblock %}
