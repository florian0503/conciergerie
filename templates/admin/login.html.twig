<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Administration — Maison Mathis</title>
    <link rel="stylesheet" href="{{ asset('styles/admin-login.css') }}">
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <strong>Maison Mathis</strong>
            <span>Administration</span>
        </div>

        {% if error %}
            <div class="login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>
    </div>
</body>
</html>
