{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{% set path = field.value ?? '' %}
{% if path starts with '/' %}
    <img src="{{ path }}" style="width:50px;height:50px;object-fit:cover;border-radius:50%;">
{% elseif path %}
    <span class="badge badge-secondary">{{ path }}</span>
{% else %}
    <span class="badge badge-secondary">—</span>
{% endif %}
