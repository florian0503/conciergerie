{% extends 'base.html.twig' %}

{% block title %}Avis — Les Clés Lyonnaises{% endblock %}
{% block meta_description %}Consultez les avis de nos propriétaires et voyageurs. Les Clés Lyonnaises, conciergerie de confiance à Lyon.{% endblock %}

{% block jsonld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Les Clés Lyonnaises",
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.95",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": {{ avis|length }}
    },
    "review": [
        {% for a in avis %}
        {
            "@type": "Review",
            "author": { "@type": "Person", "name": {{ a.nom|json_encode|raw }} },
            "reviewRating": {
                "@type": "Rating",
                "ratingValue": {{ a.note }},
                "bestRating": "5"
            },
            "reviewBody": {{ a.texte|json_encode|raw }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/avis.css') }}">
{% endblock %}

{% block body %}

<!-- ══ HERO ════════════════════════════════════════════════ -->
<section class="av-hero">
    <div class="av-wrap">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
            <a class="breadcrumb-link" href="{{ path('app_home') }}">Accueil</a>
            <span class="breadcrumb-sep">／</span>
            <span class="breadcrumb-current">Avis</span>
        </nav>
        <h1 class="av-title">
            Ce qu'ils<br>
            en <em>disent</em>.
        </h1>
        <p class="av-subtitle">Propriétaires et voyageurs — les retours de ceux qui nous ont fait confiance.</p>
    </div>
</section>

<!-- ══ STATS ══════════════════════════════════════════════ -->
<section class="av-stats">
    <div class="av-wrap">
        <div class="av-stats-grid">
            <div class="av-stat reveal" data-delay="1">
                <p class="av-stat-num"><span data-count="4.94" data-decimals="2">4.94</span><span class="av-stat-star">★</span></p>
                <p class="av-stat-label">Note moyenne voyageurs</p>
            </div>
            <div class="av-stat reveal" data-delay="2">
                <p class="av-stat-num"><span data-count="98">98</span><span class="av-stat-sup">%</span></p>
                <p class="av-stat-label">Propriétaires satisfaits</p>
            </div>
            <div class="av-stat reveal" data-delay="3">
                <p class="av-stat-num">+<span data-count="340">340</span></p>
                <p class="av-stat-label">Avis cumulés</p>
            </div>
            <div class="av-stat reveal" data-delay="4">
                <p class="av-stat-num"><span data-count="93">93</span><span class="av-stat-sup">%</span></p>
                <p class="av-stat-label">Recommanderaient</p>
            </div>
        </div>
    </div>
</section>

<!-- ══ CAROUSEL AVIS ══════════════════════════════════════ -->
<section class="av-reviews">
    <div class="av-wrap">

        <h2 class="av-reviews-title">Les mots de<br>nos voyageurs.</h2>

        {% if avis is not empty %}

        <div class="av-track" id="av-track">
            {% for a in avis %}
            <article class="av-card">
                <div class="av-stars">{% for i in 1..a.note %}★ {% endfor %}</div>
                <blockquote class="av-quote">« {{ a.texte }} »</blockquote>
                <div class="av-card-divider"></div>
                <div class="av-author">
                    <span class="av-avatar">{{ a.nom|first|upper }}</span>
                    <div>
                        <p class="av-author-name">{{ a.nom }}</p>
                        <p class="av-author-role">{{ a.role }}</p>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>

        <div class="av-carousel-nav" id="av-nav">
            <div class="av-dots" id="av-dots"></div>
            <div class="av-arrows">
                <button class="av-arrow" id="av-prev" aria-label="Précédent">←</button>
                <button class="av-arrow" id="av-next" aria-label="Suivant">→</button>
            </div>
        </div>

        {% else %}
        <p class="av-empty">Aucun avis à afficher pour le moment.</p>
        {% endif %}

    </div>
</section>

<!-- ══ PLATEFORMES ════════════════════════════════════════ -->
<section class="av-platforms">
    <div class="av-wrap">
        <p class="av-platforms-label">Nos avis sont publics sur</p>
        <div class="av-platforms-list">
            <div class="av-platform">
                <span class="av-platform-name av-platform-name--airbnb">Airbnb</span>
                <span class="av-platform-score">4.94 ★</span>
            </div>
            <div class="av-platform">
                <span class="av-platform-name av-platform-name--booking">Booking.com</span>
                <span class="av-platform-score">9.3 / 10</span>
            </div>
            <div class="av-platform">
                <span class="av-platform-name av-platform-name--google">Google</span>
                <span class="av-platform-score">4.9 ★</span>
            </div>
        </div>
    </div>
</section>

<!-- ══ CTA ════════════════════════════════════════════════ -->
<section class="av-cta">
    <div class="av-cta-inner">
        <h2 class="av-cta-title">À votre tour&nbsp;?</h2>
        <p class="av-cta-desc">Rejoignez nos propriétaires sereins.</p>
        <a href="{{ path('app_contact') }}" class="av-cta-btn">Nous contacter →</a>
    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var track  = document.getElementById('av-track');
        var dotsEl = document.getElementById('av-dots');
        var nav    = document.getElementById('av-nav');
        var prev   = document.getElementById('av-prev');
        var next   = document.getElementById('av-next');
        if (!track) return;

        var cards = Array.from(track.querySelectorAll('.av-card'));
        if (!cards.length) return;

        /* ── MOBILE : infinite auto-scroll ── */
        if (window.innerWidth <= 600) {
            nav.style.display = 'none';

            track.style.cssText = 'display:flex;flex-wrap:nowrap;overflow-x:hidden;gap:16px;' +
                'margin-left:calc(-1 * var(--gutter));margin-right:calc(-1 * var(--gutter));' +
                'padding-inline:5%;padding-bottom:4px;';
            cards.forEach(function (c) {
                c.style.cssText = 'flex:0 0 88%;scroll-snap-align:center;';
            });

            var total = cards.length;
            var clonePrev  = cards[total - 1].cloneNode(true);
            var cloneNext  = cards[0].cloneNode(true);
            track.insertBefore(clonePrev, cards[0]);
            track.appendChild(cloneNext);
            var all = Array.from(track.querySelectorAll('.av-card'));
            var cur = 1;
            var timer;

            /* dots */
            var dotsWrap = document.createElement('div');
            dotsWrap.style.cssText = 'display:flex;justify-content:center;gap:8px;margin-top:20px;';
            for (var d = 0; d < total; d++) {
                var dot = document.createElement('button');
                dot.style.cssText = 'width:6px;height:6px;border-radius:50%;border:none;cursor:pointer;padding:0;background:var(--line-strong);transition:background .2s,transform .2s;';
                if (d === 0) { dot.style.background = 'var(--red)'; dot.style.transform = 'scale(1.4)'; }
                (function(i) {
                    dot.addEventListener('click', function () { slideTo(i + 1, true); resetTimer(); });
                })(d);
                dotsWrap.appendChild(dot);
            }
            track.parentNode.insertBefore(dotsWrap, track.nextSibling);
            var dotBtns = dotsWrap.querySelectorAll('button');

            function centerOf(idx) {
                var c = all[idx];
                return c.offsetLeft - (track.offsetWidth - c.offsetWidth) / 2;
            }

            function updateDots(idx) {
                var real = ((idx - 1) % total + total) % total;
                dotBtns.forEach(function (d, i) {
                    d.style.background   = i === real ? 'var(--red)' : 'var(--line-strong)';
                    d.style.transform    = i === real ? 'scale(1.4)' : 'scale(1)';
                });
            }

            function slideTo(idx, animate) {
                cur = idx;
                var target = centerOf(idx);
                if (animate === false) { track.scrollLeft = target; }
                else { track.scrollTo({ left: target, behavior: 'smooth' }); }
                updateDots(idx);
            }

            slideTo(1, false);

            function doNext() {
                var n = cur + 1;
                slideTo(n, true);
                if (n === all.length - 1) setTimeout(function () { slideTo(1, false); }, 420);
            }

            function resetTimer() {
                clearInterval(timer);
                timer = setInterval(doNext, 3500);
            }
            resetTimer();

            var tx = 0;
            track.addEventListener('touchstart', function (e) { clearInterval(timer); tx = e.touches[0].clientX; }, { passive: true });
            track.addEventListener('touchend', function (e) {
                var dx = tx - e.changedTouches[0].clientX;
                if (Math.abs(dx) > 40) {
                    var n2 = cur + (dx > 0 ? 1 : -1);
                    slideTo(n2, true);
                    if (n2 === all.length - 1) setTimeout(function () { slideTo(1, false); }, 420);
                    if (n2 === 0)              setTimeout(function () { slideTo(total, false); }, 420);
                }
                resetTimer();
            }, { passive: true });

            return;
        }

        /* ── DESKTOP : pagination par 2 ── */
        var perPage = 2;
        var pages   = Math.ceil(cards.length / perPage);
        var cur2    = 0;

        for (var p = 0; p < pages; p++) {
            var dot2 = document.createElement('button');
            dot2.className = 'av-dot' + (p === 0 ? ' is-active' : '');
            dot2.setAttribute('data-index', p);
            dotsEl.appendChild(dot2);
        }
        var dots2 = dotsEl.querySelectorAll('.av-dot');

        function showPage(idx) {
            cur2 = (idx + pages) % pages;
            cards.forEach(function (c, i) {
                var inPage = i >= cur2 * perPage && i < (cur2 + 1) * perPage;
                c.classList.toggle('av-hidden', !inPage);
            });
            dots2.forEach(function (d, i) { d.classList.toggle('is-active', i === cur2); });
        }

        showPage(0);
        prev.addEventListener('click', function () { showPage(cur2 - 1); });
        next.addEventListener('click', function () { showPage(cur2 + 1); });
        dots2.forEach(function (dot) {
            dot.addEventListener('click', function () { showPage(+dot.getAttribute('data-index')); });
        });
    });
    </script>
{% endblock %}
