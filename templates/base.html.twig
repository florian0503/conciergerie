<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Les Clés Lyonnaises — Conciergerie Airbnb à Lyon{% endblock %}</title>

    <!-- SEO -->
    <meta name="description" content="{% block meta_description %}Les Clés Lyonnaises, conciergerie immobilière à Lyon. Gestion complète de votre location courte durée : annonces, voyageurs, ménage. Contactez-nous.{% endblock %}">
    <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Les Clés Lyonnaises">
    <meta property="og:title" content="{% block og_title %}Les Clés Lyonnaises — Conciergerie Airbnb à Lyon{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Gestion complète de votre location courte durée à Lyon. Annonces, voyageurs, ménage — nous nous occupons de tout.{% endblock %}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}/images/logo.png">
    <meta property="og:locale" content="fr_FR">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}Les Clés Lyonnaises — Conciergerie Airbnb à Lyon{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Gestion complète de votre location courte durée à Lyon.{% endblock %}">
    <meta name="twitter:image" content="{{ app.request.schemeAndHttpHost }}/images/logo.png">

    <!-- Schema JSON-LD LocalBusiness -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Les Clés Lyonnaises",
        "description": "Conciergerie immobilière à Lyon. Gestion complète de votre location courte durée : annonces, voyageurs, ménage.",
        "url": "{{ app.request.schemeAndHttpHost }}",
        "logo": "{{ app.request.schemeAndHttpHost }}/images/logo.png",
        "image": "{{ app.request.schemeAndHttpHost }}/images/logo.png",
        "telephone": "+33769314803",
        "email": "contact@cleslyonnaises.fr",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "9 Avenue Benoît Launay",
            "addressLocality": "Grézieu-la-Varenne",
            "postalCode": "69290",
            "addressCountry": "FR"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": 45.7640,
            "longitude": 4.7910
        },
        "openingHoursSpecification": [
            {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
                "opens": "09:00",
                "closes": "19:00"
            }
        ],
        "sameAs": [
            "https://www.instagram.com/les_cles_lyonnaises"
        ],
        "areaServed": {
            "@type": "City",
            "name": "Lyon"
        }
    }
    </script>

    {% block jsonld %}{% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% set _route = app.request.attributes.get('_route') %}

<!-- ═══════════════════════════════════════════════════════════
     HEADER
════════════════════════════════════════════════════════════ -->
<header class="site-header" id="site-header">


    <!-- Nav principale -->
    <div class="nav-main" id="nav-main">
        <div class="nav-inner">

            <a class="brand" href="{{ path('app_home') }}" aria-label="Les Clés Lyonnaises — accueil">
                <img src="/images/logo.png" alt="Les Clés Lyonnaises" class="brand-logo">
            </a>

            <nav class="nav-links" aria-label="Navigation principale">
                <a class="nav-link{% if _route == 'app_home' %} active{% endif %}" href="{{ path('app_home') }}">Accueil</a>
                <a class="nav-link{% if _route == 'app_services' %} active{% endif %}" href="{{ path('app_services') }}">Services</a>
                <a class="nav-link{% if _route == 'app_offres' %} active{% endif %}" href="{{ path('app_offres') }}">Offres</a>
                <a class="nav-link{% if _route in ['app_logements', 'app_logement_show'] %} active{% endif %}" href="{{ path('app_logements') }}">Logements</a>
                <a class="nav-link{% if _route == 'app_avis' %} active{% endif %}" href="{{ path('app_avis') }}">Avis</a>
                <div class="nav-dropdown{% if _route in ['app_entreprise', 'app_equipe', 'app_faq', 'app_blog'] %} active{% endif %}">
                    <button class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                        À propos
                        <svg class="nav-dropdown-caret" width="9" height="5" viewBox="0 0 9 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 4.5 4 8 1"/></svg>
                    </button>
                    <div class="nav-dropdown-menu">
                        <a class="nav-dropdown-item{% if _route == 'app_entreprise' %} active{% endif %}" href="{{ path('app_entreprise') }}">L'entreprise</a>
                        <a class="nav-dropdown-item{% if _route == 'app_equipe' %} active{% endif %}" href="{{ path('app_equipe') }}">L'équipe</a>
                        <a class="nav-dropdown-item{% if _route == 'app_faq' %} active{% endif %}" href="{{ path('app_faq') }}">FAQ</a>
                        <a class="nav-dropdown-item{% if _route == 'app_blog' %} active{% endif %}" href="{{ path('app_blog') }}">Blog</a>
                    </div>
                </div>
            </nav>

            <a class="nav-cta" href="{{ path('app_contact') }}">
                Nous contacter
                <span class="arrow">→</span>
            </a>

            <button class="nav-toggle" id="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-drawer">
                <span class="nav-toggle-icon"><span></span><span></span></span>
                <span class="nav-toggle-label">Menu</span>
            </button>

        </div>

        <div class="scroll-progress" id="scroll-progress"></div>
    </div>

    <!-- Drawer mobile -->
    <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Menu principal">
        <div class="drawer-top">
            <a class="brand brand--white" href="{{ path('app_home') }}" aria-label="Les Clés Lyonnaises">
                <img src="/images/logo.png" alt="Les Clés Lyonnaises" class="brand-logo">
            </a>
            <button class="drawer-close" id="drawer-close" aria-label="Fermer le menu">
                <span class="drawer-close-icon"><span></span><span></span></span>
                <span class="drawer-close-label">Fermer</span>
            </button>
        </div>

        <nav class="drawer-nav" aria-label="Navigation mobile">
            <div class="drawer-nav-main">
                <a class="drawer-link" href="{{ path('app_home') }}">Accueil</a>
                <a class="drawer-link" href="{{ path('app_services') }}">Services</a>
                <a class="drawer-link" href="{{ path('app_offres') }}">Offres</a>
                <a class="drawer-link" href="{{ path('app_logements') }}">Logements</a>
                <a class="drawer-link" href="{{ path('app_avis') }}">Avis</a>
            </div>
            <div class="drawer-nav-secondary">
                <a class="drawer-link-sm" href="{{ path('app_entreprise') }}">L'entreprise</a>
                <a class="drawer-link-sm" href="{{ path('app_equipe') }}">L'équipe</a>
                <a class="drawer-link-sm" href="{{ path('app_faq') }}">FAQ</a>
                <a class="drawer-link-sm" href="{{ path('app_blog') }}">Blog</a>
            </div>
        </nav>

        <div class="drawer-ctas">
            <a href="{{ path('app_contact') }}" class="drawer-btn drawer-btn--primary">Nous contacter →</a>
            <a href="{{ path('app_offres') }}" class="drawer-btn drawer-btn--ghost">Voir les tarifs</a>
        </div>
    </div>

</header>

<!-- ═══════════════════════════════════════════════════════════
     MAIN
════════════════════════════════════════════════════════════ -->
<main class="site-main">
    {% block body %}{% endblock %}
</main>

<!-- ═══════════════════════════════════════════════════════════
     FOOTER
════════════════════════════════════════════════════════════ -->
<footer class="site-footer">
    <div class="footer-inner">

        <!-- 3. Grille 4 colonnes -->
        <div class="footer-grid">

            <div class="footer-col footer-col--brand">
                <img src="/images/logo-footer.png" alt="Les Clés Lyonnaises" class="footer-brand-logo">
                <p class="footer-manifesto">Une équipe lyonnaise qui traite chaque bien comme s'il était le sien. Depuis 2021.</p>
                <p class="footer-signature">— Les Clés Lyonnaises</p>
            </div>

            <div class="footer-col">
                <h4 class="footer-col-title">Navigation</h4>
                <div class="footer-col-rule"></div>
                <ul class="footer-nav-list">
                    <li><a href="{{ path('app_home') }}" class="footer-nav-link">Accueil</a></li>
                    <li><a href="{{ path('app_services') }}" class="footer-nav-link">Services</a></li>
                    <li><a href="{{ path('app_offres') }}" class="footer-nav-link">Offres</a></li>
                    <li><a href="{{ path('app_logements') }}" class="footer-nav-link">Logements</a></li>
                    <li><a href="{{ path('app_avis') }}" class="footer-nav-link">Avis</a></li>
                    <li><a href="{{ path('app_contact') }}" class="footer-nav-link">Contact</a></li>
                    <li class="footer-nav-dropdown">
                        <button class="footer-nav-dropdown-toggle">
                            À propos
                            <svg class="footer-nav-dropdown-caret" width="9" height="5" viewBox="0 0 9 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 1 4.5 4 8 1"/></svg>
                        </button>
                        <ul class="footer-nav-sub">
                            <li><a href="{{ path('app_entreprise') }}" class="footer-nav-link">L'entreprise</a></li>
                            <li><a href="{{ path('app_equipe') }}" class="footer-nav-link">L'équipe</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="footer-col">
                <h4 class="footer-col-title">Contact</h4>
                <div class="footer-col-rule"></div>
                <ul class="footer-nav-list">
                    <li><a href="tel:+33769314803" class="footer-nav-link">+33 7 69 31 48 03</a></li>
                    <li><a href="mailto:contact@cleslyonnaises.fr" class="footer-nav-link">contact@cleslyonnaises.fr</a></li>
                    <li><a href="https://wa.me/33769314803" class="footer-nav-link" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
                    <li><a href="{{ path('app_contact') }}" class="footer-nav-link">Prendre rendez-vous</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4 class="footer-col-title">Nous trouver</h4>
                <div class="footer-col-rule"></div>
                <p class="footer-address">9 Avenue Benoît Launay<br>69290 Grézieu-la-Varenne</p>
                <p class="footer-hours">Lun — Sam · 9h — 19h</p>
                <div class="footer-map" aria-hidden="true">
                    <svg viewBox="0 0 280 120" xmlns="http://www.w3.org/2000/svg">
                        <rect width="280" height="120" fill="rgba(251,250,247,0.04)" rx="4"/>
                        <path d="M 68 0 C 62 28, 72 50, 64 78 C 57 102, 66 112, 62 120" stroke="rgba(251,250,247,0.2)" stroke-width="1.5" fill="none"/>
                        <path d="M 148 0 C 158 22, 152 46, 162 68 C 172 90, 168 106, 175 120" stroke="rgba(251,250,247,0.2)" stroke-width="1.5" fill="none"/>
                        <circle cx="108" cy="64" r="12" fill="rgba(228,87,46,0.18)" class="map-halo"/>
                        <circle cx="108" cy="64" r="5" fill="#E4572E"/>
                    </svg>
                </div>
            </div>

        </div>


        <!-- 5. Barre de bas -->
        <div class="footer-bottom">
            <p class="footer-copy">© 2026 Les Clés Lyonnaises · Conciergerie Airbnb à Lyon</p>
            <div class="footer-legal">
                <a href="{{ path('app_mentions_legales') }}" class="footer-legal-link">Mentions légales</a>
                <span aria-hidden="true">·</span>
                <a href="{{ path('app_cgu') }}" class="footer-legal-link">CGU</a>
                <span aria-hidden="true">·</span>
                <a href="{{ path('app_confidentialite') }}" class="footer-legal-link">Confidentialité</a>
                <span aria-hidden="true">·</span>
                <a href="{{ path('app_confidentialite') }}#cookies" class="footer-legal-link">Cookies</a>
            </div>
            <div class="footer-social">
                <a href="https://www.instagram.com/les_cles_lyonnaises" class="footer-social-btn" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5"/>
                        <circle cx="12" cy="12" r="4"/>
                        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>

<!-- ═══════════════════════════════════════════════════════════
     STICKY CTA MOBILE
════════════════════════════════════════════════════════════ -->
<div class="sticky-cta" id="sticky-cta">
    <a href="{{ path('app_contact') }}" class="sticky-cta-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.21 3.25 2 2 0 0 1 3.22 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 18l-.08-.08z"/>
        </svg>
        Nous contacter
    </a>
</div>

<!-- ═══════════════════════════════════════════════════════════
     COOKIE BANNER
════════════════════════════════════════════════════════════ -->
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Gestion des cookies" aria-live="polite">
    <div class="cookie-banner-inner">
        <div class="cookie-banner-text">
            <span class="cookie-banner-label">Cookies</span>
            <p class="cookie-banner-msg">
                Nous utilisons des cookies pour améliorer votre expérience et analyser notre audience.
                <a href="{{ path('app_confidentialite') }}#cookies">En savoir plus</a>
            </p>
        </div>
        <div class="cookie-banner-actions">
            <button class="cookie-btn cookie-btn--refuse" id="cookie-refuse">Refuser</button>
            <button class="cookie-btn cookie-btn--accept" id="cookie-accept">Accepter</button>
        </div>
    </div>
</div>

<button class="scroll-top" id="scroll-top" aria-label="Retour en haut">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 10 8 5 13 10"/>
    </svg>
</button>

<script>
(function () {
    /* ── HEADER SCROLL ─────────────────────────────────── */
    var topBar = document.getElementById('top-bar');
    var navMain = document.getElementById('nav-main');
    var scrollProgress = document.getElementById('scroll-progress');
    var ticking = false;

    function updateHeader() {
        var scrollY = window.pageYOffset;
        var scrollMax = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        if (scrollY > 8) {
            navMain.classList.add('is-scrolled');
            if (topBar) topBar.classList.add('is-hidden');
            scrollProgress.style.opacity = '1';
        } else {
            navMain.classList.remove('is-scrolled');
            if (topBar) topBar.classList.remove('is-hidden');
            scrollProgress.style.opacity = '0';
        }
        if (scrollMax > 0) {
            scrollProgress.style.width = (scrollY / scrollMax * 100) + '%';
        }
    }

    window.addEventListener('scroll', function () {
        if (!ticking) {
            requestAnimationFrame(function () { updateHeader(); ticking = false; });
            ticking = true;
        }
    }, { passive: true });

    /* ── MOBILE DRAWER ─────────────────────────────────── */
    var toggle = document.getElementById('nav-toggle');
    var drawer = document.getElementById('mobile-drawer');
    var drawerClose = document.getElementById('drawer-close');

    function openDrawer() {
        drawer.classList.add('is-open');
        toggle.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        drawer.querySelectorAll('.drawer-link, .drawer-link-sm').forEach(function (el, i) {
            el.style.transitionDelay = (0.08 + i * 0.06) + 's';
            el.classList.add('is-visible');
        });
    }

    function closeDrawer() {
        drawer.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        drawer.querySelectorAll('.drawer-link, .drawer-link-sm').forEach(function (el) {
            el.classList.remove('is-visible');
            el.style.transitionDelay = '0s';
        });
    }

    toggle.addEventListener('click', openDrawer);
    drawerClose.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeDrawer(); closeDropdowns(); } });

    /* ── DROPDOWN À PROPOS ─────────────────────────────── */
    var dropdowns = document.querySelectorAll('.nav-dropdown');

    function closeDropdowns() {
        dropdowns.forEach(function (d) {
            d.classList.remove('is-open');
            d.querySelector('.nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
    }

    dropdowns.forEach(function (dropdown) {
        var btn = dropdown.querySelector('.nav-dropdown-toggle');
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = dropdown.classList.contains('is-open');
            closeDropdowns();
            if (!isOpen) {
                dropdown.classList.add('is-open');
                btn.setAttribute('aria-expanded', 'true');
            }
        });
    });

    document.addEventListener('click', closeDropdowns);
    drawer.querySelectorAll('.drawer-link, .drawer-link-sm').forEach(function (el) {
        el.addEventListener('click', function () { setTimeout(closeDrawer, 120); });
    });

    /* ── REVEAL AU SCROLL ─────────────────────────────── */
    var revealObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach(function (el) {
        revealObserver.observe(el);
    });

    /* ── COMPTEUR ──────────────────────────────────────── */
    var counterObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var target = +el.getAttribute('data-count');
            var decimals = el.getAttribute('data-decimals') ? +el.getAttribute('data-decimals') : 0;
            var duration = 1400;
            var start = null;

            function step(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var ease = 1 - Math.pow(1 - progress, 3);
                var val = (target * ease);
                el.textContent = decimals ? val.toFixed(decimals) : Math.floor(val).toLocaleString('fr-FR');
                if (progress < 1) requestAnimationFrame(step);
                else el.textContent = decimals ? target.toFixed(decimals) : target.toLocaleString('fr-FR');
            }

            requestAnimationFrame(step);
            counterObserver.unobserve(el);
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('[data-count]').forEach(function (el) {
        counterObserver.observe(el);
    });

    /* ── FOOTER DROPDOWN À PROPOS ─────────────────────── */
    var footerDropdown = document.querySelector('.footer-nav-dropdown');
    if (footerDropdown) {
        footerDropdown.querySelector('.footer-nav-dropdown-toggle').addEventListener('click', function () {
            footerDropdown.classList.toggle('is-open');
        });
    }

    /* ── SCROLL TO TOP ─────────────────────────────────── */
    var scrollTopBtn = document.getElementById('scroll-top');
    var darkSections = document.querySelectorAll('.site-footer, .engagement, .sv-promesse');
    var btnHeight = 44;
    var btnBottom = 32;

    function updateScrollTop() {
        var scrollY = window.pageYOffset;
        scrollTopBtn.classList.toggle('is-visible', scrollY > 300);

        var btnTop = window.innerHeight - btnBottom - btnHeight;
        var onDark = false;
        darkSections.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top <= btnTop && r.bottom >= btnTop) onDark = true;
        });
        scrollTopBtn.classList.toggle('on-dark', onDark);
    }

    window.addEventListener('scroll', updateScrollTop, { passive: true });
    scrollTopBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    updateScrollTop();

    /* ── COOKIE BANNER ─────────────────────────────────── */
    var cookieBanner = document.getElementById('cookie-banner');
    var cookieAccept = document.getElementById('cookie-accept');
    var cookieRefuse = document.getElementById('cookie-refuse');
    var COOKIE_NAME = 'mm_cookie_consent';
    var COOKIE_DAYS = 365;

    function getCookie(name) {
        var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? decodeURIComponent(match[2]) : null;
    }

    function setCookie(name, value, days) {
        var expires = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/; SameSite=Lax';
    }

    function hideBanner() {
        cookieBanner.classList.remove('is-visible');
    }

    if (!getCookie(COOKIE_NAME)) {
        setTimeout(function () { cookieBanner.classList.add('is-visible'); }, 800);
    }

    cookieAccept.addEventListener('click', function () {
        setCookie(COOKIE_NAME, 'accepted', COOKIE_DAYS);
        hideBanner();
    });

    cookieRefuse.addEventListener('click', function () {
        setCookie(COOKIE_NAME, 'refused', COOKIE_DAYS);
        hideBanner();
    });

}());
</script>
</body>
</html>
